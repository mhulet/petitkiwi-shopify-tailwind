{%- comment -%}
  Petit Kiwi — Hero Banner (TailwindUI e-commerce hero)
  Full-width hero with image overlay, heading, and CTA
{%- endcomment -%}

<section class="relative overflow-hidden bg-cream">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative flex flex-col lg:flex-row items-center gap-8 py-16 sm:py-20 lg:py-28">

      {%- comment -%} Text content {%- endcomment -%}
      <div class="flex-1 text-center lg:text-left max-w-xl">
        {%- if section.settings.subtitle != blank -%}
          <p class="text-sm font-semibold uppercase tracking-wider text-kiwi-600 mb-3">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display text-brown leading-tight">
          {{ section.settings.heading | default: "La seconde main joyeuse pour vos enfants" }}
        </h1>

        {%- if section.settings.description != blank -%}
          <p class="mt-6 text-lg text-brown-500 leading-relaxed">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        <div class="mt-8 flex flex-wrap gap-4 justify-center lg:justify-start">
          {%- if section.settings.button_text != blank -%}
            <a href="{{ section.settings.button_url }}" class="btn-primary text-base px-8 py-3.5">
              {{ section.settings.button_text }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_text_2 != blank -%}
            <a href="{{ section.settings.button_url_2 }}" class="btn-secondary text-base px-8 py-3.5">
              {{ section.settings.button_text_2 }}
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} Trust badges {%- endcomment -%}
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 justify-center lg:justify-start text-sm text-brown-400">
          <span class="flex items-center gap-x-2">
            <svg class="h-5 w-5 text-kiwi" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            Qualit&eacute; v&eacute;rifi&eacute;e
          </span>
          <span class="flex items-center gap-x-2">
            <svg class="h-5 w-5 text-kiwi" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0H6.375c-.621 0-1.125-.504-1.125-1.125V11.25" />
            </svg>
            Livraison d&egrave;s 4,50&euro;
          </span>
          <span class="flex items-center gap-x-2">
            <svg class="h-5 w-5 text-kiwi" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 3.03v.568c0 .334.148.65.405.864l1.068.89c.442.369.535 1.01.216 1.49l-.51.766a2.25 2.25 0 0 1-1.161.886l-.143.048a1.107 1.107 0 0 0-.57 1.664c.369.555.169 1.307-.427 1.605L9 13.125l.423 1.059a.956.956 0 0 1-1.652.928l-.679-.906a1.125 1.125 0 0 0-1.906.172L4.5 15.75l-.612.153M12.75 3.031a9 9 0 1 0-8.862 12.872M12.75 3.031a9 9 0 0 1 6.69 14.036m0 0-.177-.529A2.25 2.25 0 0 0 17.128 15H16.5l-.324-.324a1.453 1.453 0 0 0-2.328.377l-.036.073a1.586 1.586 0 0 1-.982.816l-.99.282c-.55.157-.894.702-.8 1.267l.073.438c.08.474.49.821.97.821.846 0 1.598.542 1.865 1.345l.215.643m5.276-3.67a9.012 9.012 0 0 1-5.276 3.67m0 0a9 9 0 0 1-10.275-4.835M15.75 9c0 .896-.393 1.7-1.016 2.25" />
            </svg>
            &Eacute;co-responsable
          </span>
        </div>
      </div>

      {%- comment -%} Hero image {%- endcomment -%}
      <div class="flex-1 relative">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                    {{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 800 }} 800w"
            sizes="(max-width: 1024px) 100vw, 50vw"
            alt="{{ section.settings.image.alt | default: shop.name }}"
            class="rounded-3xl shadow-2xl shadow-brown/10 w-full object-cover max-h-[500px]"
            loading="eager"
            width="800"
            height="500"
          >
        {%- else -%}
          <div class="rounded-3xl bg-gradient-to-br from-kiwi-100 to-sage-100 aspect-[4/3] flex items-center justify-center">
            <span class="text-8xl">🥝</span>
          </div>
        {%- endif -%}

        {%- comment -%} Decorative elements {%- endcomment -%}
        <div class="absolute -top-4 -right-4 w-24 h-24 bg-mustard/20 rounded-full blur-2xl"></div>
        <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-kiwi/15 rounded-full blur-3xl"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bandeau principal",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Depuis 2009 \u00e0 Eghez\u00e9e"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "La seconde main joyeuse pour vos enfants"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Des v\u00eatements, jouets et mat\u00e9riel de pu\u00e9riculture de qualit\u00e9 \u00e0 prix tout doux. Parce que la seconde main, c'est bon pour la plan\u00e8te et le portefeuille.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte du bouton principal",
      "default": "D\u00e9couvrir la boutique"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien du bouton principal",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Texte du bouton secondaire",
      "default": "Comment \u00e7a marche ?"
    },
    {
      "type": "url",
      "id": "button_url_2",
      "label": "Lien du bouton secondaire"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Bandeau principal"
    }
  ]
}
{% endschema %}
