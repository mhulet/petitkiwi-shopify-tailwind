{%- comment -%}
  Petit Kiwi — Footer (TailwindUI e-commerce footer)
{%- endcomment -%}

<footer class="bg-brown-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    {%- comment -%} Main footer content {%- endcomment -%}
    <div class="py-12 lg:py-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="sm:col-span-2 lg:col-span-1">
        {%- if section.settings.logo -%}
          <img src="{{ section.settings.logo | image_url: width: 160 }}" alt="{{ shop.name }}" class="h-8 w-auto brightness-0 invert" width="160" height="auto">
        {%- else -%}
          <span class="font-display text-2xl text-cream">{{ shop.name }}</span>
        {%- endif -%}
        <p class="mt-4 text-sm text-cream-300 leading-relaxed max-w-xs">
          {{ section.settings.description | default: "La seconde main joyeuse pour les enfants de 0 à 18 ans. Depuis 2009 à Eghezée." }}
        </p>

        {%- comment -%} Social links {%- endcomment -%}
        <div class="mt-6 flex gap-x-4">
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="text-cream-400 hover:text-kiwi transition-colors" target="_blank" rel="noopener">
              <span class="sr-only">Facebook</span>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="text-cream-400 hover:text-kiwi transition-colors" target="_blank" rel="noopener">
              <span class="sr-only">Instagram</span>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Menu columns from blocks {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h3 class="text-sm font-semibold text-cream uppercase tracking-wider">{{ block.settings.title }}</h3>
            {%- if block.settings.menu != blank -%}
              <ul class="mt-4 space-y-3">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="text-sm text-cream-400 hover:text-kiwi transition-colors">
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if block.type == 'contact' -%}
          <div {{ block.shopify_attributes }}>
            <h3 class="text-sm font-semibold text-cream uppercase tracking-wider">{{ block.settings.title | default: "Contact" }}</h3>
            <ul class="mt-4 space-y-3 text-sm text-cream-400">
              {%- if block.settings.address != blank -%}
                <li class="flex gap-x-2">
                  <svg class="h-5 w-5 text-cream-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  {{ block.settings.address }}
                </li>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
                <li class="flex gap-x-2">
                  <svg class="h-5 w-5 text-cream-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                  <a href="mailto:{{ block.settings.email }}" class="hover:text-kiwi transition-colors">{{ block.settings.email }}</a>
                </li>
              {%- endif -%}
              {%- if block.settings.phone != blank -%}
                <li class="flex gap-x-2">
                  <svg class="h-5 w-5 text-cream-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                  </svg>
                  <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '/' }}" class="hover:text-kiwi transition-colors">{{ block.settings.phone }}</a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="border-t border-cream/10 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-cream-400">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits r&eacute;serv&eacute;s.
      </p>
      <div class="flex items-center gap-x-4">
        {%- comment -%} Payment icons placeholder {%- endcomment -%}
        <span class="text-xs text-cream-400">Paiement s&eacute;curis&eacute;</span>
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'h-6 w-auto text-cream-400' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "La seconde main joyeuse pour les enfants de 0 \u00e0 18 ans. Depuis 2009 \u00e0 Eghez\u00e9e."
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "La boutique"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Nous contacter"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Adresse",
          "default": "Rue du Coll\u00e8ge 35, 5310 Eghez\u00e9e"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "coucou@petitkiwi.be"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "T\u00e9l\u00e9phone",
          "default": "+32 487 11 90 66"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied de page",
      "blocks": [
        {
          "type": "menu",
          "settings": { "title": "La boutique" }
        },
        {
          "type": "menu",
          "settings": { "title": "Informations" }
        },
        {
          "type": "contact"
        }
      ]
    }
  ]
}
{% endschema %}
