{%- comment -%}
  Petit Kiwi — Featured Products (TailwindUI product overview grid)
  Shows a selection of products from a collection with quick-add
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section class="section-padding bg-cream">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-3xl sm:text-4xl font-display text-brown">
          {{ section.settings.heading | default: "Nouveautés" }}
        </h2>
        {%- if section.settings.description != blank -%}
          <p class="mt-2 text-lg text-brown-400">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="hidden sm:flex items-center gap-x-1 text-sm font-semibold text-kiwi-600 hover:text-kiwi-700 transition-colors">
          Tout voir
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4 lg:gap-8">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card-product animate-pulse">
            <div class="aspect-[3/4] bg-cream-300"></div>
            <div class="p-4 space-y-2">
              <div class="h-4 bg-cream-300 rounded w-3/4"></div>
              <div class="h-4 bg-cream-300 rounded w-1/2"></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if collection != blank -%}
      <div class="mt-8 text-center sm:hidden">
        <a href="{{ collection.url }}" class="btn-secondary">
          Voir toute la collection
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produits vedettes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nouveaut\u00e9s"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Les derni\u00e8res p\u00e9pites arriv\u00e9es en boutique"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8,
      "label": "Nombre de produits"
    }
  ],
  "presets": [
    {
      "name": "Produits vedettes"
    }
  ]
}
{% endschema %}
