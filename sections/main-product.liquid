{%- comment -%}
  Petit Kiwi — Product Page (TailwindUI product overview with image gallery)
  Two-column layout: gallery left, product info right
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_price = current_variant.compare_at_price
  assign price = current_variant.price
  assign on_sale = false
  if compare_price > price
    assign on_sale = true
  endif
-%}

<section class="section-padding bg-cream">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="mb-8" aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-x-2 text-sm text-brown-400">
        <li><a href="/" class="hover:text-kiwi-600 transition-colors">Accueil</a></li>
        {%- if collection -%}
          <li><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></li>
          <li><a href="{{ collection.url }}" class="hover:text-kiwi-600 transition-colors">{{ collection.title }}</a></li>
        {%- endif -%}
        <li><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></li>
        <li class="text-brown-700 font-medium truncate max-w-[200px]">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 lg:items-start">

      {%- comment -%} ===== IMAGE GALLERY ===== {%- endcomment -%}
      <div x-data="{ activeImage: 0 }" class="sticky top-24">
        {%- comment -%} Main image {%- endcomment -%}
        <div class="aspect-[3/4] overflow-hidden rounded-2xl bg-white">
          {%- for media in product.media -%}
            <img
              x-show="activeImage === {{ forloop.index0 }}"
              src="{{ media | image_url: width: 800 }}"
              srcset="{{ media | image_url: width: 400 }} 400w,
                      {{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 800 }} 800w"
              sizes="(max-width: 1024px) 100vw, 50vw"
              alt="{{ media.alt | default: product.title }}"
              class="h-full w-full object-cover"
              {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
              width="800"
              height="1067"
              {% unless forloop.first %}style="display:none;"{% endunless %}
            >
          {%- endfor -%}
        </div>

        {%- comment -%} Thumbnails {%- endcomment -%}
        {%- if product.media.size > 1 -%}
          <div class="mt-4 grid grid-cols-5 gap-3">
            {%- for media in product.media limit: 5 -%}
              <button
                @click="activeImage = {{ forloop.index0 }}"
                class="aspect-square overflow-hidden rounded-xl border-2 transition-colors"
                :class="activeImage === {{ forloop.index0 }} ? 'border-kiwi' : 'border-transparent hover:border-brown-200'"
              >
                <img
                  src="{{ media | image_url: width: 150 }}"
                  alt="{{ media.alt | default: product.title }}"
                  class="h-full w-full object-cover"
                  loading="lazy"
                  width="150"
                  height="150"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ===== PRODUCT INFO ===== {%- endcomment -%}
      <div class="mt-8 lg:mt-0">
        {%- comment -%} Vendor {%- endcomment -%}
        {%- if product.vendor != blank -%}
          <p class="text-sm font-semibold uppercase tracking-wider text-kiwi-600 mb-2">{{ product.vendor }}</p>
        {%- endif -%}

        {%- comment -%} Title {%- endcomment -%}
        <h1 class="text-2xl sm:text-3xl font-display text-brown">{{ product.title }}</h1>

        {%- comment -%} Price {%- endcomment -%}
        <div class="mt-4 flex items-center gap-x-3">
          <span class="text-2xl font-bold text-brown">{{ price | money }}</span>
          {%- if on_sale -%}
            <span class="text-lg text-brown-300 line-through">{{ compare_price | money }}</span>
            {%- assign discount_pct = compare_price | minus: price | times: 100.0 | divided_by: compare_price | round -%}
            <span class="badge bg-terra/10 text-terra font-bold">-{{ discount_pct }}%</span>
          {%- endif -%}
        </div>

        {%- comment -%} Tags as badges {%- endcomment -%}
        {%- if product.tags.size > 0 -%}
          <div class="mt-4 flex flex-wrap gap-2">
            {%- for tag in product.tags limit: 5 -%}
              {%- unless tag contains '_' -%}
                <span class="badge bg-cream-300 text-brown-500">{{ tag }}</span>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Add to cart form {%- endcomment -%}
        <form method="post" action="/cart/add" id="product-form-{{ product.id }}" class="mt-8">
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="variant-id-{{ product.id }}">

          {%- comment -%} Variant selector {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="mb-6">
                <label class="block text-sm font-semibold text-brown-700 mb-3">{{ option.name }}</label>
                <div class="flex flex-wrap gap-2">
                  {%- for value in option.values -%}
                    {%- assign option_idx = 'option' | append: option.position -%}
                    <label class="relative cursor-pointer">
                      <input type="radio" name="{{ option.name }}" value="{{ value }}"
                             {% if value == option.selected_value %}checked{% endif %}
                             class="peer sr-only"
                             onchange="
                               var params = new URLSearchParams(window.location.search);
                               params.set('{{ option.name }}', this.value);
                               window.location.search = params.toString();
                             ">
                      <span class="block rounded-full border-2 border-brown-200 px-4 py-2 text-sm font-medium text-brown-700 peer-checked:border-kiwi peer-checked:bg-kiwi/10 peer-checked:text-kiwi-700 hover:border-kiwi/50 transition-colors">
                        {{ value }}
                      </span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          {%- comment -%} Quantity {%- endcomment -%}
          <div class="mb-6">
            <label for="Quantity" class="block text-sm font-semibold text-brown-700 mb-3">Quantit&eacute;</label>
            <div class="inline-flex items-center rounded-full border border-brown-200 bg-white">
              <button type="button" class="px-3 py-2 text-brown-400 hover:text-brown-700"
                      onclick="var q=document.getElementById('Quantity');q.value=Math.max(1,parseInt(q.value)-1);">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" />
                </svg>
              </button>
              <input type="number" id="Quantity" name="quantity" value="1" min="1"
                     class="w-12 text-center border-0 text-sm font-medium text-brown-700 focus:ring-0 bg-transparent">
              <button type="button" class="px-3 py-2 text-brown-400 hover:text-brown-700"
                      onclick="var q=document.getElementById('Quantity');q.value=parseInt(q.value)+1;">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </button>
            </div>
          </div>

          {%- comment -%} Add to cart button {%- endcomment -%}
          {%- if product.available -%}
            <button type="submit" class="btn-primary w-full text-base py-4">
              <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
              Ajouter au panier
            </button>
          {%- else -%}
            <button type="button" disabled class="w-full rounded-full bg-brown-200 py-4 text-base font-semibold text-brown-400 cursor-not-allowed">
              Vendu
            </button>
          {%- endif -%}
        </form>

        {%- comment -%} Trust indicators {%- endcomment -%}
        <div class="mt-8 grid grid-cols-3 gap-4">
          <div class="text-center">
            <div class="mx-auto w-10 h-10 rounded-full bg-kiwi/10 flex items-center justify-center mb-2">
              <svg class="h-5 w-5 text-kiwi-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <p class="text-xs font-medium text-brown-500">Qualit&eacute; v&eacute;rifi&eacute;e</p>
          </div>
          <div class="text-center">
            <div class="mx-auto w-10 h-10 rounded-full bg-kiwi/10 flex items-center justify-center mb-2">
              <svg class="h-5 w-5 text-kiwi-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0H6.375c-.621 0-1.125-.504-1.125-1.125V11.25" />
              </svg>
            </div>
            <p class="text-xs font-medium text-brown-500">Livraison rapide</p>
          </div>
          <div class="text-center">
            <div class="mx-auto w-10 h-10 rounded-full bg-kiwi/10 flex items-center justify-center mb-2">
              <svg class="h-5 w-5 text-kiwi-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
            </div>
            <p class="text-xs font-medium text-brown-500">Paiement s&eacute;curis&eacute;</p>
          </div>
        </div>

        {%- comment -%} Description {%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="mt-10 border-t border-brown-200/30 pt-8">
            <h2 class="text-lg font-display text-brown mb-4">Description</h2>
            <div class="prose prose-sm text-brown-500 max-w-none prose-headings:text-brown prose-headings:font-display prose-a:text-kiwi-600">
              {{ product.description }}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} Schema.org structured data {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncatewords: 100 | json }},
  "image": {{ product.featured_image | image_url: width: 800 | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ current_variant.price | money_without_currency | strip }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/SoldOut{% endif %}",
    "itemCondition": "https://schema.org/UsedCondition",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
}
</script>

{% schema %}
{
  "name": "Page produit",
  "tag": "section",
  "settings": []
}
{% endschema %}
