{%- comment -%}
  Petit Kiwi — Header (TailwindUI e-commerce storefront navigation)
  Features: announcement bar, logo, mega menu, search, cart
{%- endcomment -%}

{%- liquid
  assign cart_count = cart.item_count
-%}

<header x-data="{ mobileMenuOpen: false, searchOpen: false }" class="sticky top-0 z-40">
  {%- if section.settings.show_announcement -%}
    <div class="bg-kiwi text-white text-center text-sm py-2 px-4 font-medium">
      <p>{{ section.settings.announcement_text }}</p>
    </div>
  {%- endif -%}

  <nav class="bg-cream/95 backdrop-blur-md border-b border-brown-200/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">

        {%- comment -%} Mobile menu button {%- endcomment -%}
        <div class="flex lg:hidden">
          <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-brown">
            <span class="sr-only">Ouvrir le menu</span>
            <svg x-show="!mobileMenuOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <svg x-show="mobileMenuOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="display:none;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        {%- comment -%} Logo {%- endcomment -%}
        <div class="flex lg:flex-none">
          <a href="/" class="-m-1.5 p-1.5">
            {%- if section.settings.logo -%}
              <img
                src="{{ section.settings.logo | image_url: width: 200 }}"
                alt="{{ shop.name }}"
                class="h-10 w-auto"
                width="200"
                height="auto"
                loading="eager"
              >
            {%- else -%}
              <span class="font-display text-2xl text-brown">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        {%- comment -%} Desktop navigation {%- endcomment -%}
        <div class="hidden lg:flex lg:flex-1 lg:justify-center lg:gap-x-8">
          {%- for link in section.settings.menu.links -%}
            {%- if link.links.size > 0 -%}
              <div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative">
                <button @click="open = !open" class="flex items-center gap-x-1 text-sm font-medium text-brown-700 hover:text-kiwi-600 transition-colors py-5">
                  {{ link.title }}
                  <svg class="h-4 w-4 flex-none text-brown-300" :class="{ 'rotate-180': open }" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </button>

                <div x-show="open"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 -translate-y-1"
                     x-transition:enter-end="opacity-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 translate-y-0"
                     x-transition:leave-end="opacity-0 -translate-y-1"
                     class="absolute left-1/2 z-10 mt-0 w-56 -translate-x-1/2 rounded-2xl bg-white p-2 shadow-lg ring-1 ring-brown-200/20"
                     style="display: none;">
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="block rounded-xl px-4 py-2.5 text-sm text-brown-700 hover:bg-cream hover:text-kiwi-600 transition-colors">
                      {{ child.title }}
                    </a>
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="text-sm font-medium text-brown-700 hover:text-kiwi-600 transition-colors py-5">
                {{ link.title }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Right: search + account + cart {%- endcomment -%}
        <div class="flex items-center gap-x-4">
          {%- comment -%} Search toggle {%- endcomment -%}
          <button @click="searchOpen = !searchOpen" class="text-brown-700 hover:text-kiwi-600 transition-colors">
            <span class="sr-only">Rechercher</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
          </button>

          {%- comment -%} Account {%- endcomment -%}
          <a href="{{ routes.account_url }}" class="hidden sm:block text-brown-700 hover:text-kiwi-600 transition-colors">
            <span class="sr-only">Mon compte</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </a>

          {%- comment -%} Cart {%- endcomment -%}
          <a href="{{ routes.cart_url }}" class="group relative text-brown-700 hover:text-kiwi-600 transition-colors">
            <span class="sr-only">Panier</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            {%- if cart_count > 0 -%}
              <span class="absolute -top-2 -right-2 flex h-5 w-5 items-center justify-center rounded-full bg-kiwi text-[11px] font-bold text-white">
                {{ cart_count }}
              </span>
            {%- endif -%}
          </a>
        </div>
      </div>
    </div>

    {%- comment -%} Search bar (expandable) {%- endcomment -%}
    <div x-show="searchOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 -translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-2"
         class="border-t border-brown-200/30 bg-white py-4 px-4 sm:px-6 lg:px-8"
         style="display: none;">
      <div class="mx-auto max-w-2xl">
        <form action="{{ routes.search_url }}" method="get" class="relative">
          <input type="hidden" name="type" value="product">
          <input
            type="search"
            name="q"
            placeholder="Rechercher un article, une marque..."
            class="w-full rounded-full border border-brown-200 bg-cream py-3 pl-12 pr-4 text-sm text-brown-700 placeholder-brown-300 focus:border-kiwi focus:ring-2 focus:ring-kiwi/20 focus:outline-none"
            x-ref="searchInput"
            @keydown.escape="searchOpen = false"
          >
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-brown-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </form>
      </div>
    </div>

    {%- comment -%} Mobile menu {%- endcomment -%}
    <div x-show="mobileMenuOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="lg:hidden border-t border-brown-200/30 bg-white"
         style="display: none;">
      <div class="space-y-1 px-4 py-4">
        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            <div x-data="{ subOpen: false }">
              <button @click="subOpen = !subOpen" class="flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-base font-medium text-brown-700 hover:bg-cream">
                {{ link.title }}
                <svg class="h-5 w-5 text-brown-300 transition-transform" :class="{ 'rotate-180': subOpen }" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </button>
              <div x-show="subOpen" x-collapse class="pl-4 space-y-1">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}" class="block rounded-xl px-3 py-2 text-sm text-brown-500 hover:bg-cream hover:text-kiwi-600">
                    {{ child.title }}
                  </a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="block rounded-xl px-3 py-2.5 text-base font-medium text-brown-700 hover:bg-cream hover:text-kiwi-600">
              {{ link.title }}
            </a>
          {%- endif -%}
        {%- endfor -%}

        <div class="border-t border-brown-200/30 pt-4 mt-4">
          <a href="{{ routes.account_url }}" class="flex items-center gap-x-3 rounded-xl px-3 py-2.5 text-base font-medium text-brown-700 hover:bg-cream">
            <svg class="h-5 w-5 text-brown-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
            Mon compte
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

{%- comment -%} Alpine.js for interactive components {%- endcomment -%}
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js" defer></script>

{% schema %}
{
  "name": "En-tête",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu de navigation"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "Afficher la barre d'annonce"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "default": "Livraison en Belgique \u00e0 partir de 4,50\u20ac \u2014 Retrait gratuit en magasin \u00e0 Eghez\u00e9e",
      "label": "Texte d'annonce"
    }
  ]
}
{% endschema %}
