{%- comment -%}
  Petit Kiwi — Featured Collections Grid (TailwindUI category previews)
  Displays collection cards with images in a responsive grid
{%- endcomment -%}

<section class="section-padding bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    {%- if section.settings.heading != blank -%}
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-display text-brown">{{ section.settings.heading }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="mt-3 text-lg text-brown-400">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-{{ section.settings.columns }} lg:gap-8">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <a href="{{ collection.url | default: '#' }}"
           class="group relative overflow-hidden rounded-2xl bg-cream aspect-[3/4] sm:aspect-[4/5]"
           {{ block.shopify_attributes }}>

          {%- if collection.image != blank or collection.featured_image != blank -%}
            {%- assign img = collection.image | default: collection.featured_image -%}
            <img
              src="{{ img | image_url: width: 600 }}"
              srcset="{{ img | image_url: width: 300 }} 300w,
                      {{ img | image_url: width: 450 }} 450w,
                      {{ img | image_url: width: 600 }} 600w"
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
              alt="{{ collection.title | default: block.settings.title }}"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              width="600"
              height="750"
            >
          {%- else -%}
            <div class="absolute inset-0 bg-gradient-to-br from-kiwi-100 to-cream"></div>
          {%- endif -%}

          {%- comment -%} Gradient overlay {%- endcomment -%}
          <div class="absolute inset-0 bg-gradient-to-t from-brown-900/60 via-brown-900/10 to-transparent"></div>

          {%- comment -%} Label {%- endcomment -%}
          <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6">
            <h3 class="text-lg sm:text-xl font-display text-white drop-shadow-sm">
              {{ collection.title | default: block.settings.title | default: "Collection" }}
            </h3>
            {%- if collection.products_count > 0 -%}
              <p class="mt-1 text-sm text-white/80">
                {{ collection.products_count }} article{{ collection.products_count | pluralize: '', 's' }}
              </p>
            {%- endif -%}
          </div>

          {%- comment -%} Hover arrow {%- endcomment -%}
          <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="rounded-full bg-white/90 p-2">
              <svg class="h-4 w-4 text-brown" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="mt-10 text-center">
        <a href="{{ section.settings.button_url | default: '/collections' }}" class="btn-secondary">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections vedettes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nos cat\u00e9gories"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Tout pour vos enfants, de 0 \u00e0 18 ans"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Colonnes (desktop)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte du bouton",
      "default": "Voir toutes les cat\u00e9gories"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre (si pas de collection)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections vedettes",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
