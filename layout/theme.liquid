<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#A8C66C">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% if template contains 'noindexnofollow' %}
      <meta name="robots" content="noindex,nofollow">
    {% endif %}

    {% render 'meta-tags' %}

    {%- comment -%} Tailwind CSS via CDN with Petit Kiwi custom config {%- endcomment -%}
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              kiwi: {
                50: '#f4f9e8',
                100: '#e6f1cc',
                200: '#cfe4a0',
                300: '#b8d674',
                400: '#A8C66C',
                500: '#7CA656',
                600: '#5f8a3e',
                700: '#476b2f',
                800: '#354f24',
                900: '#243519',
                DEFAULT: '#A8C66C',
              },
              brown: {
                50: '#faf6f1',
                100: '#f0e6d6',
                200: '#dfc9a8',
                300: '#cba97a',
                400: '#8B6F47',
                500: '#76593a',
                600: '#5e472e',
                700: '#473523',
                800: '#302418',
                DEFAULT: '#8B6F47',
              },
              cream: {
                50: '#FDFCFA',
                100: '#F9F6F0',
                200: '#F5F0E8',
                300: '#EDE5D6',
                400: '#E0D4BF',
                DEFAULT: '#F5F0E8',
              },
              rose: {
                50: '#faf5f5',
                100: '#f2e4e4',
                200: '#e5c8c8',
                300: '#D4A0A0',
                400: '#c07a7a',
                DEFAULT: '#D4A0A0',
              },
              mustard: {
                50: '#fdf9ed',
                100: '#f9f0d1',
                200: '#f2e0a3',
                300: '#E8C96A',
                400: '#d4af37',
                DEFAULT: '#E8C96A',
              },
              sage: {
                50: '#f0f5eb',
                100: '#dce8d2',
                200: '#b9d1a5',
                300: '#96ba78',
                400: '#7CA656',
                500: '#5f8a3e',
                DEFAULT: '#7CA656',
              },
              terra: {
                50: '#faf3ef',
                100: '#f2e1d8',
                200: '#e4c2b0',
                300: '#C4836A',
                400: '#a96b52',
                DEFAULT: '#C4836A',
              },
              sky: {
                50: '#f2f6f9',
                100: '#e0eaf1',
                200: '#c1d5e3',
                300: '#9AB0C4',
                400: '#7a95ad',
                DEFAULT: '#9AB0C4',
              },
            },
            fontFamily: {
              sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
              display: ['DM Serif Display', 'Georgia', 'serif'],
            },
            maxWidth: {
              '8xl': '88rem',
            },
          },
        },
      }
    </script>

    {%- comment -%} Google Fonts: Inter + DM Serif Display {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {%- comment -%} Petit Kiwi base styles (overrides and utilities) {%- endcomment -%}
    <style type="text/tailwindcss">
      @layer base {
        html {
          @apply scroll-smooth;
        }
        body {
          @apply font-sans text-brown-700 bg-cream antialiased;
        }
        h1, h2, h3, h4, h5, h6 {
          @apply font-display text-brown;
        }
      }
      @layer components {
        .btn-primary {
          @apply inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-kiwi rounded-full hover:bg-kiwi-500 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-kiwi-400 focus:ring-offset-2;
        }
        .btn-secondary {
          @apply inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-brown border-2 border-brown-200 rounded-full hover:border-kiwi hover:text-kiwi-600 transition-colors duration-200;
        }
        .badge {
          @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium;
        }
        .badge-kiwi {
          @apply badge bg-kiwi-100 text-kiwi-700;
        }
        .badge-rose {
          @apply badge bg-rose-100 text-rose-400;
        }
        .card-product {
          @apply group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300;
        }
        .section-padding {
          @apply py-12 sm:py-16 lg:py-20;
        }
      }
    </style>

    {{ content_for_header }}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-kiwi focus:text-white" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="flex-1 focus:outline-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
      };
    </script>

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
