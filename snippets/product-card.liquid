{%- comment -%}
  Petit Kiwi — Product Card (TailwindUI e-commerce product card)
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign compare_price = first_variant.compare_at_price
  assign price = first_variant.price
  assign on_sale = false
  if compare_price > price
    assign on_sale = true
  endif
-%}

<div class="card-product">
  {%- comment -%} Image {%- endcomment -%}
  <a href="{{ product.url }}" class="block relative aspect-[3/4] overflow-hidden">
    {%- if product.featured_image != blank -%}
      <img
        src="{{ product.featured_image | image_url: width: 400 }}"
        srcset="{{ product.featured_image | image_url: width: 200 }} 200w,
                {{ product.featured_image | image_url: width: 300 }} 300w,
                {{ product.featured_image | image_url: width: 400 }} 400w,
                {{ product.featured_image | image_url: width: 600 }} 600w"
        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
        alt="{{ product.featured_image.alt | default: product.title }}"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        width="400"
        height="533"
      >

      {%- if product.images.size > 1 -%}
        <img
          src="{{ product.images[1] | image_url: width: 400 }}"
          alt="{{ product.images[1].alt | default: product.title }}"
          class="absolute inset-0 h-full w-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          loading="lazy"
          width="400"
          height="533"
        >
      {%- endif -%}
    {%- else -%}
      <div class="h-full w-full bg-cream-300 flex items-center justify-center">
        <svg class="h-12 w-12 text-brown-300" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
        </svg>
      </div>
    {%- endif -%}

    {%- comment -%} Badges {%- endcomment -%}
    <div class="absolute top-3 left-3 flex flex-col gap-1.5">
      {%- if on_sale -%}
        <span class="badge bg-terra text-white text-[10px] font-bold uppercase tracking-wider">Promo</span>
      {%- endif -%}
      {%- if product.available == false -%}
        <span class="badge bg-brown-700 text-white text-[10px] font-bold uppercase tracking-wider">Vendu</span>
      {%- endif -%}
      {%- for tag in product.tags -%}
        {%- if tag == 'neuf' or tag == 'Neuf' -%}
          <span class="badge-kiwi text-[10px] font-bold uppercase tracking-wider">Neuf</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </a>

  {%- comment -%} Product info {%- endcomment -%}
  <div class="p-4">
    {%- if product.vendor != blank -%}
      <p class="text-xs font-medium text-kiwi-600 uppercase tracking-wider mb-1">{{ product.vendor }}</p>
    {%- endif -%}

    <h3 class="text-sm font-medium text-brown-700 line-clamp-2">
      <a href="{{ product.url }}" class="hover:text-kiwi-600 transition-colors">
        {{ product.title }}
      </a>
    </h3>

    <div class="mt-2 flex items-center gap-x-2">
      <span class="text-base font-bold text-brown">{{ price | money }}</span>
      {%- if on_sale -%}
        <span class="text-sm text-brown-300 line-through">{{ compare_price | money }}</span>
        {%- assign discount_pct = compare_price | minus: price | times: 100.0 | divided_by: compare_price | round -%}
        <span class="text-xs font-semibold text-terra">-{{ discount_pct }}%</span>
      {%- endif -%}
    </div>

    {%- if product.available -%}
      <form method="post" action="/cart/add" class="mt-3">
        <input type="hidden" name="id" value="{{ first_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="w-full rounded-full bg-kiwi/10 py-2 text-xs font-semibold text-kiwi-700 hover:bg-kiwi hover:text-white transition-colors duration-200">
          Ajouter au panier
        </button>
      </form>
    {%- else -%}
      <p class="mt-3 text-center py-2 text-xs font-medium text-brown-300">Vendu</p>
    {%- endif -%}
  </div>
</div>
