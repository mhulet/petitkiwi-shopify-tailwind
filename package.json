{
  "name": "petitkiwi-shopify-tailwind",
  "version": "1.0.0",
  "description": "Thème Shopify Petit Kiwi (Dawn + Tailwind CSS v4) et son Design System",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i assets/app-tailwind.css -o assets/app.css --minify",
    "watch:css": "tailwindcss -i assets/app-tailwind.css -o assets/app.css --watch",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrellisCommerce/shopify-dawn-tailwind-starter-base.git"
  },
  "author": "Trellis",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TrellisCommerce/shopify-dawn-tailwind-starter-base/issues"
  },
  "homepage": "https://github.com/TrellisCommerce/shopify-dawn-tailwind-starter-base#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "husky": "^7.0.4",
    "lint-staged": "^12.3.3",
    "prettier": "^2.5.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@trelliscommerce/prettier-config": "^1.0.0"
  },
  "prettier": "@trelliscommerce/prettier-config",
  "lint-staged": {
    "*.{js,css}": "prettier --write"
  }
}
